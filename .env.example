# Copy this file to .env and fill in your own values.
# Never commit the real .env file.

# Your Yahoo Mail address
YAHOO_EMAIL=you@yahoo.com

# A Yahoo "App Password" - NOT your normal account password.
# Generate one at: https://login.yahoo.com/myaccount/security
# (Account security > Generate app password)
YAHOO_APP_PASSWORD=your16charapppassword

# Optional overrides (defaults shown)
YAHOO_IMAP_HOST=imap.mail.yahoo.com
YAHOO_IMAP_PORT=993
YAHOO_SMTP_HOST=smtp.mail.yahoo.com
YAHOO_SMTP_PORT=465
